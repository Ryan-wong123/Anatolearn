FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.30-alpine
# Pick up Alpine security fixes published since the base image was built (Trivy fails the build on fixable HIGH/CRITICAL
# findings), then drop back to the image's unprivileged user (uid 101, as the Kubernetes manifests expect).
USER root
RUN apk upgrade --no-cache
USER 101
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY ops/nginx-upstream.conf /etc/nginx/upstream.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY ops/maintenance.html /usr/share/nginx/html/maintenance.html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
