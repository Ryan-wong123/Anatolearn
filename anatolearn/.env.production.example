# Copy to .env.production and fill in. Never commit the real file.
# Secrets: JWT_SECRET -> openssl rand -base64 48 ; database passwords -> openssl rand -hex 24 (avoid @ / : characters)
POSTGRES_PASSWORD=
# Password for the least-privilege role the API uses at runtime (only read when the database is first created)
APP_DB_PASSWORD=
JWT_SECRET=
TEACHER_INVITE_CODE=
# Optional: only allow registration from these email domains, comma separated (e.g. school.edu,students.school.edu)
ALLOWED_EMAIL_DOMAINS=
# Domain pointing at the EC2 instance (Caddy gets the HTTPS certificate automatically)
SITE_DOMAIN=anatolearn.example.com
FRONTEND_ORIGINS=https://anatolearn.example.com
# S3 storage (credentials come from the EC2 instance role, never put keys here)
AWS_REGION=ap-southeast-1
S3_BUCKET=
S3_PREFIX=
# Virus scanning: true rejects uploads while the scanner is down
CLAMAV_REQUIRED=true
BACKUP_INTERVAL_HOURS=24
