{
  "name": "anatolearn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:viewer": "node --experimental-strip-types --test tests/viewer.test.mjs",
    "preview": "vite preview",
    "test:api": "node --experimental-strip-types --test tests/api.test.mjs",
    "test:models": "node --test tests/model-formats.test.mjs",
    "test:browser": "playwright test",
    "test:browser:report": "playwright show-report",
    "test:browser:summary": "node tests/browser/report-summary.mjs",
    "test:e2e": "playwright test -c playwright.e2e.config.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "lucide-react": "^1.71.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  }
}
